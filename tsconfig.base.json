{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@patentrack/core": ["./packages/core/src"],
      "@patentrack/shared": ["./packages/shared/src"],
      "@patentrack/db": ["./packages/db/src"],
      "@patentrack/api": ["./packages/api/src"],
      "@patentrack/monitoring": ["./packages/monitoring/src"],
      "@patentrack/ingestion": ["./packages/ingestion/src"],
      "@patentrack/processing": ["./packages/processing/src"],
      "@patentrack/scheduler": ["./packages/scheduler/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
